[Unit]
Description=Bluetooth RSSI D-Bus Service
Documentation=https://github.com/ba0f3/gnome-bluetooth-smartlock
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=dbus
BusName=org.gnome.BluetoothRSSI
ExecStart=/usr/local/bin/bt-rssi
Restart=on-failure

# Runs as a dedicated unprivileged system user.
# CAP_NET_ADMIN is required for the HCI management socket (HCI_CHANNEL_CONTROL);
# the CapabilityBoundingSet below limits the process to that single capability.

# Note: DynamicUser= was tried first but the classic dbus-daemon fails to
# authenticate its transient synthetic UID against the system bus (connection
# dies with BrokenPipe immediately). A static system user avoids that and also
# lets the D-Bus policy restrict bus-name ownership to exactly this user.
User=bt-rssi
Group=bt-rssi
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
